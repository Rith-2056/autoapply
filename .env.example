# Copy to .env and fill in. Never commit .env.

# LLM used for free-text application questions (Anthropic).
ANTHROPIC_API_KEY=

# Optional: Workday accounts. Workday requires a per-company account.
# Format: one JSON object mapping the Workday hostname to credentials.
# Leave empty to have every Workday listing marked "needs_manual".
# WORKDAY_ACCOUNTS={"gdit.wd5.myworkdayjobs.com": {"email": "you@example.com", "password": "..."}}
WORKDAY_ACCOUNTS=
