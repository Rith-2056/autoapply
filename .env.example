# Copy to .env and fill in. Never commit .env.

# LLM used for free-text application questions (Anthropic).
ANTHROPIC_API_KEY="your-anthropic-api-key-here"
# Optional: Workday accounts. Workday requires a per-company account.
# Format: one JSON object mapping the Workday hostname to credentials.
# Leave empty to have every Workday listing marked "needs_manual".
# WORKDAY_ACCOUNTS={"gdit.wd5.myworkdayjobs.com": {"email": "you@example.com", "password": "..."}}
WORKDAY_ACCOUNTS=

# Optional: key used to encrypt the Gmail OAuth token at rest (a random one is generated in data/ otherwise).
AUTOAPPLY_SECRET_KEY=
# Optional: path to the Google OAuth desktop client JSON (default config/google_oauth_client.json).
GOOGLE_OAUTH_CLIENT_FILE=
